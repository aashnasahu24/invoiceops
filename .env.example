# Copy to .env (never commit .env).

# Leave blank for local development: uses invoiceops.db in the project folder (SQLite).
# For PostgreSQL (e.g. Neon) paste the provider URL as-is; postgres:// and
# postgresql:// are rewritten for the psycopg driver automatically.
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

GEMINI_API_KEY=
# Set this to a Gemini model that supports structured outputs on your account.
GEMINI_MODEL="gemini-3.8-flash"

# Only needed when the tesseract binary is not on PATH (typical on Windows), e.g.
#   TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Defaults are developer-friendly when APP_ENV=development (or unset).
# In production, automatic reference-data upserts, reset and reviewer actions
# default off. Seed explicitly with `python -m scripts.seed_data` after review.
APP_ENV=development
# Optional local/production overrides (by default each follows APP_ENV):
# AUTO_SEED_REFERENCE_DATA=true
# ENABLE_DEMO_RESET=true
# ENABLE_REVIEWER_ACTIONS=true
# In production, enabling reviewer actions also requires a shared key.
# REVIEWER_ACCESS_KEY=
